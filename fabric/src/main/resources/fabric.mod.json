{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
      "Adubbz"
    ],
    "contact": {
      "homepage": "${mod_page_url}",
      "sources": "${mod_git_url}"
    },
    "license": "${mod_license}",
    "icon": "tb_icon.png",
    "environment": "*",
    "entrypoints": {
      "main": [
        "terrablender.core.TerraBlenderFabric"
      ]
    },
    "mixins": [
      "${mod_id}.mixins.json",
      "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
      "fabricloader": "*",
      "fabric-api": "*",
      "minecraft": "${minecraft_version}",
      "java": ">=17"
    },
  "accessWidener": "${mod_id}.accesswidener",
    "custom": {
      "modmenu": {
        "badges": [
          "library"
        ],
        "links": {
          "modmenu.discord": "${mod_discord_url}"
        }
      }
    }
  }
  